{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filon.example/contracts/offer-optimization/v2/offer-optimization-run.schema.json",
  "title": "FILON Offer Optimization v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_version", "context_digest", "raw_context_retained",
    "outcome", "selected_product_ref", "selected_offer_ref", "evaluations", "result_digest"
  ],
  "properties": {
    "schema_version": { "const": "offer-optimization/v2" },
    "policy_version": { "const": "offer-optimization-policy/v2" },
    "context_digest": { "$ref": "#/$defs/digest" },
    "raw_context_retained": { "const": false },
    "outcome": { "enum": ["OFFER_SELECTED", "ABSTAINED", "NO_ELIGIBLE_OFFER"] },
    "selected_product_ref": { "type": ["string", "null"], "pattern": "^(product|model|variant):.+$" },
    "selected_offer_ref": { "type": ["string", "null"], "pattern": "^offer:.+$" },
    "evaluations": { "type": "array", "items": { "$ref": "#/$defs/evaluation" } },
    "result_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "money": { "type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
    "score": { "type": ["string", "null"], "pattern": "^(0(?:\\.[0-9]+)?|1(?:\\.0+)?)$" },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_ref", "product_ref", "status", "selection_rank", "total_cost",
        "cashback_amount", "landed_cost", "currency", "return_period_days",
        "merchant_reliability", "freshness", "reason_codes", "evidence_refs"
      ],
      "properties": {
        "offer_ref": { "type": "string", "pattern": "^offer:.+$" },
        "product_ref": { "type": "string", "pattern": "^(product|model|variant):.+$" },
        "status": { "enum": ["SELECTED", "ELIGIBLE", "UNOPTIMIZABLE", "INELIGIBLE"] },
        "selection_rank": { "type": ["integer", "null"], "minimum": 1 },
        "total_cost": { "$ref": "#/$defs/money" },
        "cashback_amount": { "$ref": "#/$defs/money" },
        "landed_cost": { "$ref": "#/$defs/money" },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "return_period_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 3650 },
        "merchant_reliability": { "$ref": "#/$defs/score" },
        "freshness": { "$ref": "#/$defs/score" },
        "reason_codes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["SELECTED", "ELIGIBLE"] } } },
          "then": {
            "properties": {
              "total_cost": { "type": "string" },
              "cashback_amount": { "type": "string" },
              "landed_cost": { "type": "string" },
              "currency": { "type": "string" },
              "return_period_days": { "type": "integer" }
            }
          },
          "else": {
            "properties": {
              "selection_rank": { "type": "null" },
              "total_cost": { "type": "null" },
              "cashback_amount": { "type": "null" },
              "landed_cost": { "type": "null" },
              "currency": { "type": "null" },
              "return_period_days": { "type": "null" }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "OFFER_SELECTED" } } },
      "then": { "properties": { "selected_offer_ref": { "type": "string" } } },
      "else": { "properties": { "selected_offer_ref": { "type": "null" } } }
    }
  ]
}
