{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filon.be/contracts/personal-stylist/v1/decision.schema.json",
  "title": "FILON Personal Stylist decision",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "looks", "usedOwnedFirst", "unknowns"],
      "properties": {
        "status": { "const": "solution" },
        "looks": { "type": "array", "minItems": 1, "maxItems": 3 },
        "usedOwnedFirst": { "const": true },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "unknowns"],
      "properties": {
        "status": { "const": "abstain" },
        "reason": { "type": "string", "minLength": 1 },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    }
  ]
}
