{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filon.be/contracts/wardrobe/v1/item.schema.json",
  "title": "FILON Wardrobe local item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "role", "attributes", "provenance", "storageScope", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "role": { "enum": ["base", "structure", "footwear", "accessory"] },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "size", "material"],
      "properties": {
        "color": { "type": ["string", "null"], "maxLength": 64 },
        "size": { "type": ["string", "null"], "maxLength": 64 },
        "material": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "provenance": { "const": "user_declared" },
    "storageScope": { "const": "local_device" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
