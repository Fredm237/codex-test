{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filon.local/contracts/v2-chain/v1/online-response.schema.json",
  "title": "FILON V2 online response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reader_version",
    "outcome",
    "query_digest",
    "reason_codes",
    "items",
    "provenance",
    "raw_query_retained"
  ],
  "properties": {
    "schema_version": {"const": "v2-online-response/v2"},
    "reader_version": {"const": "v2-online-reader/v2"},
    "outcome": {"enum": ["ABSTAIN", "FACTUAL_OPTIONS"]},
    "query_digest": {"$ref": "#/$defs/digest"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/option"}
    },
    "provenance": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/provenance"},
      "allOf": [
        {"contains": {"properties": {"stage": {"const": "hybrid_retrieval"}}, "required": ["stage"]}},
        {"contains": {"properties": {"stage": {"const": "constraint_engine"}}, "required": ["stage"]}},
        {"contains": {"properties": {"stage": {"const": "product_ranking"}}, "required": ["stage"]}},
        {"contains": {"properties": {"stage": {"const": "offer_optimization"}}, "required": ["stage"]}},
        {"contains": {"properties": {"stage": {"const": "confidence"}}, "required": ["stage"]}},
        {"contains": {"properties": {"stage": {"const": "buy_wait"}}, "required": ["stage"]}}
      ]
    },
    "raw_query_retained": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "ABSTAIN"}}, "required": ["outcome"]},
      "then": {"properties": {"items": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "FACTUAL_OPTIONS"}}, "required": ["outcome"]},
      "then": {"properties": {"items": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{2})$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref", "offer_ref", "name", "brand", "image_url",
        "merchant", "merchant_ref", "price", "availability", "observed_at",
        "destination_url", "ranking_basis", "unknowns", "evidence_refs"
      ],
      "properties": {
        "entity_ref": {"type": "string", "pattern": "^(product|model|variant):.+$"},
        "offer_ref": {"type": "string", "pattern": "^offer:[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "brand": {"type": ["string", "null"]},
        "image_url": {"type": ["string", "null"]},
        "merchant": {"type": "string", "minLength": 1},
        "merchant_ref": {"type": "string", "pattern": "^merchant:[1-9][0-9]*$"},
        "price": {"$ref": "#/$defs/money"},
        "availability": {"const": "in_stock"},
        "listing_market": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}$"
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "destination_url": {"type": ["string", "null"]},
        "ranking_basis": {"const": "retrieval_and_hard_constraints_only"},
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "result_digest"],
      "properties": {
        "stage": {
          "enum": [
            "hybrid_retrieval",
            "constraint_engine",
            "product_ranking",
            "offer_optimization",
            "confidence",
            "buy_wait"
          ]
        },
        "result_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
