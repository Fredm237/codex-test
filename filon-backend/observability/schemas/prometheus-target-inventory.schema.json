{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filon.local/schemas/prometheus-target-inventory-v1.json",
  "title": "FILON Prometheus replica inventory v1",
  "description": "Secret-free file_sd inventory. Runtime compilation additionally requires the platform replica count or explicit disabled mode.",
  "type": "array",
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "targets",
      "labels"
    ],
    "properties": {
      "targets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+:[0-9]{1,5}$"
        }
      },
      "labels": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment",
          "cluster",
          "replica"
        ],
        "properties": {
          "environment": {
            "$ref": "#/$defs/closedLabel"
          },
          "cluster": {
            "$ref": "#/$defs/closedLabel"
          },
          "replica": {
            "$ref": "#/$defs/closedLabel"
          }
        }
      }
    }
  },
  "$defs": {
    "closedLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    }
  }
}
