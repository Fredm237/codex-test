# Copiez en .env et adaptez. Le mode mock permet de tester le dialogue, mais ne
# produit jamais une preuve produit, un prix ou une décision d'achat publiable.

ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Infrastructure (laisser vide pour démarrer sans dépendances)
DATABASE_URL=postgresql+asyncpg://filon:filon@postgres:5432/filon
# Mode normal : le service valide Alembic et ne modifie jamais le schéma.
# Le mode historique "legacy" est local uniquement et interdit en déploiement.
DATABASE_SCHEMA_MODE=alembic
# Contrôle atomique P0 shadows + P1–P10 : off → shadow → dark → canary → public.
# Tout mode actif conserve tous les writers. DARK sert toujours V1 et observe V2
# invisiblement. CANARY/PUBLIC exigent en plus le digest exact d'un reçu de
# promotion append-only présent en base ; une variable seule ne peut pas ouvrir
# le lecteur.
V2_CHAIN_MODE=off
# Seuil de la commande explicite de récupération ; le Cron normal ne termine
# jamais de lease automatiquement.
V2_CHAIN_STALE_AFTER_SECONDS=14400
# Digest SHA-256 public d'une campagne de promotion précise.
V2_CHAIN_CAMPAIGN_ID=
V2_CANARY_READER_ENABLED=false
V2_PUBLIC_READER_ENABLED=false
V2_PROMOTION_RECEIPT_EVALUATION_ID=
# Cohorte CANARY fermée : digests pseudonymisés CSV, jamais les identités.
V2_CANARY_SUBJECT_DIGESTS=
# Périmètre CANARY/PUBLIC explicite ; laisser vide garde le lecteur fermé.
V2_SUPPORTED_VERTICALS=
V2_SUPPORTED_LOCALES=
V2_SUPPORTED_DECISION_TYPES=
V2_MAX_DATA_AGE_SECONDS=
# Shadow append-only ; aucun lecteur public. Activer d'abord sur un lot borné.
OBSERVATION_SHADOW_ENABLED=false
# Product/Variant Graph exact-GTIN, toujours subordonné au shadow ci-dessus.
PRODUCT_GRAPH_SHADOW_ENABLED=false
ENTITY_RESOLUTION_SHADOW_ENABLED=false
OFFER_GRAPH_SHADOW_ENABLED=false
OFFER_TRUTH_SHADOW_ENABLED=false
PRODUCT_ONTOLOGY_SHADOW_ENABLED=false
HYBRID_RETRIEVAL_SHADOW_ENABLED=false
CONSTRAINT_ENGINE_SHADOW_ENABLED=false
PRODUCT_RANKING_SHADOW_ENABLED=false
OFFER_OPTIMIZATION_SHADOW_ENABLED=false
CONFIDENCE_SHADOW_ENABLED=false
BUY_WAIT_SHADOW_ENABLED=false
# Personal Commerce est un opt-in P18 distinct. Le secret HMAC doit contenir
# 32-256 caractères ASCII imprimables sans espace avant toute activation.
PERSONAL_COMMERCE_SHADOW_ENABLED=false
PERSONAL_COMMERCE_SUBJECT_SECRET=
MERCHANT_INTELLIGENCE_SHADOW_ENABLED=false
EVIDENCE_ENGINE_SHADOW_ENABLED=false
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Quota distribué : "local" conserve le compteur par processus historique.
# "redis" exige REDIS_URL et un secret partagé distinct de 32-256 caractères ;
# aucune panne Redis ne retombe silencieusement sur un quota local neuf.
RATE_LIMIT_BACKEND=local
# "railway" lit l'unique X-Real-IP injecté par l'edge et exige les identifiants
# Railway canoniques ; conserver "asgi" hors d'un déploiement Railway.
RATE_LIMIT_IDENTITY_SOURCE=asgi
RATE_LIMIT_IDENTITY_SECRET=
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25

# Frontière proxy : localement, seul le loopback est fiable. Sur Railway,
# remplacer par les IP/CIDR exacts et vérifiés du proxy devant ce service.
# Ne jamais utiliser "*", /0 ou une combinaison couvrant tout IPv4/IPv6.
FORWARDED_ALLOW_IPS=127.0.0.1

# Export OpenMetrics : secret distinct, 32-256 caractères ASCII non blancs. Sans
# valeur, /health/metrics/openmetrics répond 503 et aucun scrape n'est possible.
METRICS_EXPORT_TOKEN=

# Routage LLM par tâche : mock | deepseek | kimi | glm
LLM_PROVIDER_DEFAULT=mock
LLM_PROVIDER_REASONING=mock
LLM_PROVIDER_LONG=mock

# Clés (renseignez pour activer le fournisseur correspondant)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-128k

GLM_API_KEY=
GLM_MODEL=glm-4

# Candidats externes Google Shopping via SerpApi, jamais preuves à eux seuls.
# Sans clé ou sans réconciliation Core courante : abstention, aucune estimation.
SERPAPI_API_KEY=
SERPAPI_GL=be
SERPAPI_HL=fr

# ── Affiliation & catalogue Awin ────────────────────────────────────────────
# AWIN_PUBLISHER_ID n'est PAS secret (il figure dans les liens). Le token API et
# la clé de feed SONT des secrets : à définir sur Railway, jamais dans le code.
AWIN_PUBLISHER_ID=3005443
# Token API Publisher (liste des marchands inscrits + liens affiliés)
AWIN_API_TOKEN=
# Clé de feed produits (Toolbox → Create-a-Feed dans l'UI Awin). Peut différer
# du token API. Sans elle, l'ingestion des offres produits est désactivée.
AWIN_FEED_API_KEY=
# Régions du catalogue (codes pays, séparés par des virgules)
AWIN_REGIONS=BE,FR,LU,NL
# Garde-fou : nb max de feeds ingérés par run (0 = tous)
AWIN_FEED_LIMIT=0
# Garde-fou mémoire : nb max de lignes ingérées par feed.
# 0 utilise encore le plafond dur interne de 250 000 lignes.
AWIN_MAX_ROWS_PER_FEED=100000
# Taille maximale du téléchargement puis du contenu décompressé.
AWIN_MAX_DOWNLOAD_BYTES=268435456
AWIN_MAX_DECOMPRESSED_BYTES=536870912
# Fenêtre du job autonome. Ne pas planifier le service quand la valeur vaut 0 :
# une invocation de python -m app.ingest.scheduler exige une valeur strictement positive.
AWIN_AUTO_SYNC_HOURS=0

# Jeton protégeant les endpoints d'admin (POST /api/catalog/sync/*). Secret.
ADMIN_SYNC_TOKEN=
